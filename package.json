{
  "name": "procedural-enclosure-toolkit",
  "version": "1.0.0",
  "description": "An open, citation-based standard for verifying adherence to court procedure and professional ethics.",
  "main": "build-templates.js",
  "directories": {
    "doc": "docs",
    "example": "examples"
  },
  "scripts": {
    "build:css": "npx tailwindcss -i ./src/styles.css -o ./docs/styles.css --minify",
    "watch:css": "npx tailwindcss -i ./src/styles.css -o ./docs/styles.css --watch",
    "build": "npm run build:css && node build-templates.js",
    "build:templates": "node build-templates.js",
    "dev": "npm run watch:css",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/josephfusco/procedural-compliance.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/josephfusco/procedural-compliance/issues"
  },
  "homepage": "https://github.com/josephfusco/procedural-compliance#readme",
  "dependencies": {
    "@uswds/compile": "^1.3.1",
    "@uswds/uswds": "^3.13.0",
    "marked": "^16.4.1"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.24",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19"
  }
}
