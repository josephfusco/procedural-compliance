{
  "name": "procedural-compliance",
  "version": "1.0.0",
  "description": "An open documentary reference for New York Article 78 procedure and federal mandamus.",
  "main": "build-templates.js",
  "directories": {
    "doc": "docs",
    "example": "examples"
  },
  "scripts": {
    "build:css": "gulp compile",
    "watch:css": "gulp watch",
    "build": "npm run build:css && node build-templates.js",
    "build:templates": "node build-templates.js",
    "serve": "serve docs -l 8080",
    "dev": "npm run serve",
    "screenshot": "node scripts/screenshot.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/josephfusco/procedural-compliance.git"
  },
  "license": "MIT",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/josephfusco/procedural-compliance/issues"
  },
  "homepage": "https://github.com/josephfusco/procedural-compliance#readme",
  "dependencies": {
    "gray-matter": "^4.0.3",
    "marked": "^16.4.1"
  },
  "devDependencies": {
    "@uswds/compile": "^1.2.1",
    "@uswds/uswds": "^3.13.0",
    "playwright": "^1.59.1",
    "serve": "^14.2.5"
  }
}
